  "clips": [
    {"id":"d01-narrator","scene":1,"role":"旁白","voice":"怡婷","text":"歡迎來到居家風險劇場。看不見的空氣，也會隨著生活改變。一頓晚餐，讓我們看見房子如何察覺風險，守護家人的呼吸。"},
    {"id":"d02-narrator","scene":2,"role":"旁白","voice":"怡婷","text":"烹飪前，六項空氣指標維持平穩。持續偵測，才能發現接下來的變化。"},
    {"id":"d03-child","scene":3,"role":"孩子","voice":"軒軒","text":"媽！我回來了，肚子好餓，晚餐好了嗎？"},
    {"id":"d03-mother","scene":3,"role":"媽媽","voice":"婉婷","text":"等我一下，我現在就來準備。你先去做功課，等等就好囉！"},
    {"id":"d03-narrator","scene":3,"role":"旁白","voice":"怡婷","text":"鍋裡升起的油煙，正向室內擴散。細懸浮微粒與揮發性有機物，也跟著增加。"},
    {"id":"d04-alert","scene":4,"role":"空氣管家","voice":"文彬","text":"偵測到廚房污染指標上升，請將抽油煙機切換至強檔。"},
    {"id":"d04-exhaust","scene":4,"role":"空氣管家","voice":"文彬","text":"負壓排煙已啟動，將油煙集中帶離，減少向室內擴散。"},
    {"id":"d05-fresh","scene":5,"role":"空氣管家","voice":"文彬","text":"新風與空氣清淨已啟動。清新空氣持續送入，減少油煙向休息空間擴散。"},
    {"id":"d06-child-invite","scene":6,"role":"孩子","voice":"軒軒","text":"哇！感覺好好吃，媽，要不要一起來吃？"},
    {"id":"d06-mother","scene":6,"role":"媽媽","voice":"婉婷","text":"好哇！我關一下爐火，就好囉！"},
    {"id":"d06-child-eat","scene":6,"role":"孩子","voice":"軒軒","text":"好喔！我要開動了！"},
    {"id":"d06-narrator","scene":6,"role":"旁白","voice":"怡婷","text":"烹飪結束後，淨化仍持續進行。從負壓防護、正壓守護，到持續淨化，我們觀察變化，也確認處置結果。因為每一口呼吸、每一位家人，都值得被好好照顧。"}
  ]
}
